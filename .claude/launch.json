{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8742"],
      "port": 8742
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8743", "--directory", "docs"],
      "port": 8743
    }
    ,{
      "name": "quarto-preview",
      "runtimeExecutable": "quarto",
      "runtimeArgs": ["preview", "--port", "8744", "--no-browser"],
      "port": 8744
    }
  ]
}
